generator client {
  provider = "prisma-client"
  output   = "../apps/api/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ChatType {
  DIRECT
  GROUP
  CHANNEL
  SAVED
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
  SUBSCRIBER
}

enum IdentityType {
  EMAIL
  PHONE
}

enum VerificationPurpose {
  REGISTER
  LOGIN
  RECOVERY
}

enum MessageDeleteScope {
  NONE
  FOR_SENDER
  FOR_EVERYONE
}

model User {
  id             String                  @id @default(uuid()) @db.Uuid
  username       String                  @unique @db.VarChar(32)
  createdAt      DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?               @db.Timestamptz(3)
  profile        UserProfile?
  status         UserStatus?
  privacy        UserPrivacySettings?
  preferences    UserPreferences?
  identities     AuthIdentity[]
  password       PasswordCredential?
  sessions       Session[]
  memberships    ChatMember[]
  messages       Message[]
  reads          ChatReadCursor[]
  drafts         ChatDraft[]
  pins           ChatPin[]
  reactions      MessageReaction[]
  contacts       UserContact[]           @relation("ContactOwner")
  contactOf      UserContact[]           @relation("ContactTarget")
  blocks         UserBlock[]             @relation("BlockOwner")
  blockedBy      UserBlock[]             @relation("BlockTarget")
  sentDeliveries MessageDelivery[]       @relation("DeliveryRecipient")
  readReceipts   MessageReadReceipt[]
}

model UserProfile {
  userId      String   @id @db.Uuid
  displayName String   @db.VarChar(64)
  surname     String?  @db.VarChar(64)
  bio         String?  @db.VarChar(160)
  avatarUrl   String?  @db.VarChar(2048)
  birthday    DateTime? @db.Date
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserStatus {
  userId     String    @id @db.Uuid
  lastSeenAt DateTime? @db.Timestamptz(3)
  emoji      String?   @db.VarChar(32)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPrivacySettings {
  userId             String  @id @db.Uuid
  showLastSeen       Boolean @default(true)
  allowDirectMessage Boolean @default(true)
  allowChatInvites   Boolean @default(true)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  userId   String @id @db.Uuid
  locale   String @default("uz") @db.VarChar(8)
  theme    String @default("system") @db.VarChar(16)
  timezone String @default("Asia/Tashkent") @db.VarChar(64)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  type       IdentityType
  value      String       @db.VarChar(320)
  verifiedAt DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([type, value])
  @@index([userId])
}

model VerificationChallenge {
  id         String              @id @default(uuid()) @db.Uuid
  identity   String              @db.VarChar(320)
  purpose    VerificationPurpose
  codeHash   String              @db.VarChar(255)
  attempts   Int                 @default(0)
  expiresAt  DateTime            @db.Timestamptz(3)
  consumedAt DateTime?           @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)

  @@index([identity, purpose, createdAt])
}

model PasswordCredential {
  userId       String   @id @db.Uuid
  passwordHash String   @db.VarChar(255)
  changedAt    DateTime @default(now()) @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(255)
  userAgent        String?   @db.VarChar(512)
  ipHash           String?   @db.VarChar(128)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt       DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model UserContact {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  contactId String   @db.Uuid
  nickname  String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  owner     User     @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact   User     @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
}

model UserBlock {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  owner     User     @relation("BlockOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlockTarget", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([ownerId, blockedId])
}

model Chat {
  id          String           @id @default(uuid()) @db.Uuid
  type        ChatType
  title       String?          @db.VarChar(128)
  avatarUrl   String?          @db.VarChar(2048)
  directKey   String?          @unique @db.VarChar(73)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime?        @db.Timestamptz(3)
  members     ChatMember[]
  messages    Message[]
  readCursors ChatReadCursor[]
  drafts      ChatDraft[]
  pins        ChatPin[]
  messagePins MessagePin[]

  @@index([updatedAt, id])
}

model ChatMember {
  id        String     @id @default(uuid()) @db.Uuid
  chatId    String     @db.Uuid
  userId    String     @db.Uuid
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now()) @db.Timestamptz(3)
  leftAt    DateTime?  @db.Timestamptz(3)
  chat      Chat       @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, leftAt, chatId])
}

model ChatReadCursor {
  id            String    @id @default(uuid()) @db.Uuid
  chatId        String    @db.Uuid
  userId        String    @db.Uuid
  lastMessageId String?   @db.Uuid
  readAt        DateTime  @default(now()) @db.Timestamptz(3)
  chat          Chat      @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastMessage   Message?  @relation("ReadCursorMessage", fields: [lastMessageId], references: [id], onDelete: SetNull)

  @@unique([chatId, userId])
  @@index([userId, readAt])
}

model ChatDraft {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @db.Uuid
  userId    String   @db.Uuid
  content   String   @db.VarChar(4096)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
}

model ChatPin {
  id        String   @id @default(uuid()) @db.Uuid
  chatId    String   @db.Uuid
  userId    String   @db.Uuid
  position  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chatId, userId])
  @@index([userId, position])
}

model Message {
  id                String                 @id @default(uuid()) @db.Uuid
  clientMessageId   String                 @db.Uuid
  chatId            String                 @db.Uuid
  senderId          String                 @db.Uuid
  content           String                 @db.VarChar(4096)
  replyToId         String?                @db.Uuid
  editedAt          DateTime?              @db.Timestamptz(3)
  deletedAt         DateTime?              @db.Timestamptz(3)
  deleteScope       MessageDeleteScope     @default(NONE)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  chat              Chat                   @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender            User                   @relation(fields: [senderId], references: [id], onDelete: Restrict)
  replyTo           Message?               @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies           Message[]              @relation("MessageReplies")
  cursorFor          ChatReadCursor[]       @relation("ReadCursorMessage")
  reactions         MessageReaction[]
  pins              MessagePin[]
  deliveries        MessageDelivery[]
  receipts          MessageReadReceipt[]

  @@unique([senderId, clientMessageId])
  @@index([chatId, createdAt, id])
  @@index([senderId, createdAt])
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String   @db.VarChar(32)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model MessagePin {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  chatId    String   @db.Uuid
  pinnedBy  String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([messageId, chatId])
}

model MessageDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  messageId   String    @db.Uuid
  recipientId String    @db.Uuid
  deliveredAt DateTime? @db.Timestamptz(3)
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  recipient   User      @relation("DeliveryRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([messageId, recipientId])
}

model MessageReadReceipt {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  readAt    DateTime @default(now()) @db.Timestamptz(3)
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}
