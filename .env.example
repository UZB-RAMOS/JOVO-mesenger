# App
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# PostgreSQL (timestamps are stored in UTC)
POSTGRES_DB=jovo
POSTGRES_USER=jovo
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://jovo:change-me-local-only@localhost:5432/jovo?schema=public

# Authentication — replace outside local development
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=30
DEV_SHOW_VERIFICATION_CODE=true
OTP_EMAIL_PROVIDER_ENABLED=false
COOKIE_SECURE=false

# SMS / phone OTP provider (Uzbekistan +998).
# Default (SMS_PROVIDER=none): no real SMS is sent — in development the code is
# logged by the API and returned as devVerificationCode. To send real SMS, set
# SMS_PROVIDER=eskiz and provide your Eskiz.uz account credentials.
SMS_PROVIDER=none
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_FROM=4546

# Redis / jobs / presence
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (Phase 3; not configured for production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=jovo-private
S3_ACCESS_KEY=jovo-local
S3_SECRET_KEY=change-me-local-only
MINIO_ROOT_USER=jovo-local
MINIO_ROOT_PASSWORD=change-me-local-only

# WebRTC (Phase 5; not configured)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
