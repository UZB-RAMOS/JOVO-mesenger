{
  "name": "@jovo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --platform node --target node22 --sourcemap --clean",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "bullmq": "^5.64.1",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^4.0.14"
  }
}
